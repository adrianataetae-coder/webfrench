---
import MainLayout from '../../layouts/MainLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import GrammarIntro from '../../components/GrammarIntro.astro';
import { LEVELS } from '../../types';
import type { Level } from '../../types';

export function getStaticPaths() {
  return LEVELS.map(level => ({
    params: { level: level.id },
  }));
}

const { level } = Astro.params;
const levelInfo = LEVELS.find(l => l.id === level)!;
---

<MainLayout title={levelInfo.name} level={level as Level}>
  <PageHeader title={levelInfo.name} description={levelInfo.description} color={levelInfo.color} />

  <GrammarIntro level={level as Level} />

  <a href={`/${level}/lecciones`} class="lessons-link" style={`--lv: ${levelInfo.color};`}>
    <span class="lessons-link-text">Ver todas las lecciones</span>
    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 10h10M11 6l4 4-4 4"/></svg>
  </a>
</MainLayout>

<style>
  .lessons-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 24px;
    padding: 14px 24px;
    background: var(--lv);
    color: white;
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.15rem;
    transition: all 0.2s;
  }
  .lessons-link:hover {
    transform: translateX(4px);
    box-shadow: var(--shadow);
  }
  .lessons-link-text {
    flex: 1;
  }
</style>
