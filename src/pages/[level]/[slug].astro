---
import MainLayout from '../../layouts/MainLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PhraseBlock from '../../components/PhraseBlock.astro';
import VerbConjugation from '../../components/VerbConjugation.astro';
import LessonGrammar from '../../components/LessonGrammar.astro';
import { getLessonsByLevel } from '../../data/parser';
import { VERBS } from '../../data/verbs';
import { GRAMMAR } from '../../data/grammarByLesson';
import { LEVELS } from '../../types';
import type { Level } from '../../types';

export function getStaticPaths() {
  const params: { params: { level: Level; slug: string } }[] = [];
  for (const levelInfo of LEVELS) {
    for (const lesson of levelInfo.lessons) {
      params.push({ params: { level: levelInfo.id, slug: lesson.slug } });
    }
  }
  return params;
}

const { level, slug } = Astro.params;
const lessons = getLessonsByLevel(level as Level);
const lesson = lessons.find(l => l.slug === slug);

if (!lesson) {
  return Astro.redirect(`/${level}`);
}

const levelInfo = LEVELS.find(l => l.id === level)!;
const lessonKey = `${level}/${slug}`;
const verbs = VERBS[lessonKey] || [];
const grammarTips = GRAMMAR[lessonKey] || [];
---

<MainLayout
  title={`${lesson.title} - ${levelInfo.name}`}
  level={level as Level}
  lesson={slug}
>
  <div class="lesson" style={`--lv: ${levelInfo.color};`}>
    <PageHeader
      title={lesson.title}
      description={`${lesson.tense} · ${lesson.theme}`}
      color={levelInfo.color}
    />

    {grammarTips.length > 0 && (
      <LessonGrammar tips={grammarTips} />
    )}

    {verbs.length > 0 && (
      <VerbConjugation verbs={verbs} />
    )}

    {lesson.blocks.map(block => (
      <section class="section">
        <h2 class="section-title">{block.title}</h2>
        <div class="phrases">
          {block.phrases.map(phrase => (
            <PhraseBlock
              phrase={phrase}
              audioBase={lesson.audioPath}
              level={level as string}
              blockIndex={block.id - 1}
            />
          ))}
        </div>
      </section>
    ))}

    {lesson.vocabulary.length > 0 && (
      <section class="vocab">
        <h2 class="vocab-title">Vocabulario</h2>
        <div class="vocab-grid">
          {lesson.vocabulary.map(item => (
            <div class="vocab-card">
              <div class="vocab-french">{item.term}</div>
              <div class="vocab-phonetic">{item.pronunciation}</div>
              <div class="vocab-es">{item.translation}</div>
            </div>
          ))}
        </div>
      </section>
    )}
  </div>
</MainLayout>

<style>
  .lesson {
    padding-bottom: 60px;
  }
  .section {
    margin-bottom: 36px;
  }
  .section-title {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(1.4rem, 3vw, 1.7rem);
    font-weight: 400;
    color: var(--text);
    margin: 0 0 18px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--lv);
    display: inline-block;
  }
  .phrases {
    display: grid;
    gap: 16px;
  }

  .vocab {
    margin-top: 44px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }
  .vocab-title {
    font-family: 'DM Serif Display', serif;
    font-size: 1.4rem;
    font-weight: 400;
    margin: 0 0 18px;
    color: var(--text);
  }
  .vocab-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 10px;
  }
  @media (max-width: 600px) {
    .vocab-grid {
      grid-template-columns: 1fr;
    }
  }
  .vocab-card {
    padding: 14px 16px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: border-color 0.15s;
  }
  .vocab-card:hover {
    border-color: #d0d0e0;
  }
  .vocab-french {
    font-weight: 700;
    font-size: 1.18rem;
    color: var(--text);
    margin-bottom: 3px;
  }
  .vocab-phonetic {
    font-style: italic;
    color: var(--purple);
    font-size: 1.05rem;
    margin-bottom: 5px;
    font-family: 'Georgia', serif;
  }
  .vocab-es {
    color: var(--text-secondary);
    font-size: 1.12rem;
  }
</style>
