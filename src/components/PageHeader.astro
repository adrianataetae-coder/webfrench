---
interface Props {
  title: string;
  description?: string;
  color?: string;
}

const { title, description, color = '#667eea' } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<header class="header">
  <a href={`${base}/`} class="back-link">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 4l-4 4 4 4"/></svg>
    Inicio
  </a>
  <h1 class="header-title">{title}</h1>
  {description && <p class="header-desc">{description}</p>}
</header>

<style>
  .header {
    margin-bottom: 32px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 500;
    margin-bottom: 14px;
    transition: color 0.15s;
  }
  .back-link:hover { color: var(--text); }
  .header-title {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 400;
    color: var(--text);
    margin: 0 0 8px;
    letter-spacing: -0.01em;
  }
  .header-desc {
    font-size: 1.2rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.55;
  }
</style>
