---
interface Props {
  title: string;
  instructions: string;
  questions: { id: string; number: number | string; text: string; type: string; options?: { label: string; text: string }[]; prefix?: string; answer?: string }[];
  sectionIndex: number;
}

const { title, instructions, questions, sectionIndex } = Astro.props;

function renderText(text: string): string {
  return text
    .replace(/BLANKMARKER/g, '')
    .replace(/→/g, '<span class="arrow">→</span>')
    .replace(/«/g, '«')
    .replace(/»/g, '»')
    .replace(/_(.+?)_/g, '<em>$1</em>');
}
---

<div class="exam-section" data-section={sectionIndex}>
  <div class="section-header">
    <h3 class="section-title">{title}</h3>
    {instructions && <p class="section-instructions">{instructions}</p>}
  </div>

  <div class="section-body">
    {questions.map((q) => {
      const parts = q.text.split('BLANKMARKER');
      const hasBlank = parts.length > 1;
      return (
        <div class="exam-q" data-qid={q.id} data-type={q.type}>
          {q.prefix && <div class="q-subtitle">{q.prefix}</div>}
          <div class="q-row">
            <span class="q-num">{q.number}.</span>
            <div class="q-main">
              {q.type === 'choice' && q.options ? (
                <>
                  <div class="q-text" set:html={renderText(parts[0])} />
                  <div class="q-options">
                    {q.options.map(opt => (
                      <label class="exam-option">
                        <input type="radio" name={q.id} value={opt.label} class="option-radio" />
                        <span class="option-letter">{opt.label})</span>
                        <span class="option-text" set:html={renderText(opt.text)} />
                      </label>
                    ))}
                  </div>
                </>
              ) : q.type === 'select' && q.options ? (
                <div class="q-text">
                  <span set:html={renderText(parts[0])} />
                  <select class="exam-select" data-qid={q.id}>
                    <option value="">Selecciona...</option>
                    {q.options.map(opt => (
                      <option value={opt.label}>{opt.label}) {opt.text}</option>
                    ))}
                  </select>
                </div>
              ) : q.type === 'input' && hasBlank ? (
                <div class="q-text">
                  <span set:html={renderText(parts[0] + ' : ')} />
                  <input type="text" class="exam-input" data-qid={q.id} placeholder="..." />
                  {parts[1] && <span set:html={renderText(parts[1])} />}
                </div>
              ) : (
                <div class="q-textarea-wrap">
                  <div class="q-text" set:html={renderText(q.text)} />
                  {q.answer ? (
                    <input type="text" class="exam-input" data-qid={q.id} placeholder="Escribe tu respuesta aquí..." />
                  ) : (
                    <textarea class="exam-textarea" data-qid={q.id} rows={3} placeholder="Escribe tu respuesta aquí..."></textarea>
                  )}
                </div>
              )}
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <div class="section-footer">
    <button class="check-btn" data-section={sectionIndex}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 13l4 4L19 7"/></svg>
      Comprobar
    </button>
    <button class="reset-btn" data-section={sectionIndex}>Limpiar</button>
    <div class="section-score" data-section={sectionIndex}></div>
  </div>
</div>

<style>
  .exam-section {
    margin-bottom: 28px;
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    background: var(--bg-card);
  }
  .section-header {
    padding: 24px 28px 0;
  }
  .section-title {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(1.2rem, 2.5vw, 1.45rem);
    font-weight: 400;
    color: var(--text);
    margin: 0 0 10px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--lv, #667eea);
  }
  .section-instructions {
    font-size: 1.05rem;
    color: var(--text-secondary, #64748b);
    font-style: italic;
    margin: 0;
    line-height: 1.6;
    padding: 12px 16px;
    background: rgba(0,0,0,0.02);
    border-radius: 8px;
    border-left: 3px solid var(--lv, #667eea);
  }
  .section-body {
    padding: 20px 28px;
    display: grid;
    gap: 10px;
  }

  .exam-q {
    padding: 14px 18px;
    background: rgba(0,0,0,0.015);
    border-radius: 10px;
    border: 2px solid transparent;
    transition: border-color 0.2s, background 0.15s;
  }
  .exam-q:hover {
    background: rgba(0,0,0,0.03);
  }
  .q-subtitle {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text-muted, #64748b);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 8px;
  }
  .q-row {
    display: flex;
    gap: 12px;
  }
  .q-num {
    font-weight: 700;
    color: var(--lv, #667eea);
    font-size: 1.05rem;
    min-width: 28px;
    flex-shrink: 0;
    padding-top: 2px;
  }
  .q-main { flex: 1; min-width: 0; }
  .q-text {
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--text);
  }
  :global(.q-text em) {
    font-style: italic;
    color: var(--purple, #7c3aed);
  }
  :global(.q-text .arrow) {
    color: var(--lv, #667eea);
    font-weight: 700;
  }

  .exam-input {
    display: block;
    width: 100%;
    padding: 8px 10px;
    border: none;
    border-bottom: 2px solid var(--lv, #667eea);
    background: transparent;
    font-family: inherit;
    font-size: 1.05rem;
    color: var(--text);
    outline: none;
    transition: border-color 0.2s, background 0.2s;
    border-radius: 4px 4px 0 0;
    margin: 8px 0 0;
    vertical-align: baseline;
  }
  .exam-input:focus {
    background: rgba(99,102,241,0.06);
    border-bottom-color: #7c3aed;
  }
  .exam-input::placeholder {
    color: var(--text-muted, #94a3b8);
    font-style: italic;
  }

  .exam-select {
    padding: 5px 10px;
    border: 1px solid var(--border, #d1d5db);
    border-radius: 8px;
    background: white;
    font-family: inherit;
    font-size: 0.98rem;
    color: var(--text);
    cursor: pointer;
    outline: none;
    margin-left: 6px;
    transition: border-color 0.15s;
  }
  .exam-select:focus {
    border-color: var(--lv, #667eea);
  }

  .q-textarea-wrap {
    display: grid;
    gap: 10px;
  }
  .exam-textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--border, #d1d5db);
    border-radius: 10px;
    background: white;
    font-family: inherit;
    font-size: 1.05rem;
    color: var(--text);
    resize: vertical;
    outline: none;
    transition: border-color 0.15s;
    line-height: 1.6;
  }
  .exam-textarea:focus {
    border-color: var(--lv, #667eea);
  }
  .exam-textarea::placeholder {
    color: var(--text-muted, #94a3b8);
    font-style: italic;
  }

  .q-options {
    margin-top: 10px;
    display: grid;
    gap: 4px;
  }
  .exam-option {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 14px;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.12s;
    font-size: 1.05rem;
    color: var(--text-secondary, #475569);
  }
  .exam-option:hover {
    background: rgba(99,102,241,0.06);
  }
  :global(.option-radio) {
    accent-color: var(--lv, #667eea);
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
  :global(.option-letter) {
    font-weight: 700;
    color: var(--lv, #667eea);
    min-width: 24px;
  }
  :global(.option-text) {
    flex: 1;
  }
  :global(.option-text em) {
    font-style: italic;
    color: var(--purple, #7c3aed);
  }

  .section-footer {
    padding: 16px 28px 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-top: 1px solid var(--border-light, #f1f5f9);
  }
  .check-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 22px;
    background: var(--lv, #667eea);
    color: white;
    border: none;
    border-radius: 10px;
    font-family: inherit;
    font-size: 0.98rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.15s, transform 0.1s;
  }
  .check-btn:hover { opacity: 0.9; }
  .check-btn:active { transform: scale(0.97); }

  .reset-btn {
    padding: 10px 18px;
    background: transparent;
    color: var(--text-muted, #94a3b8);
    border: 1px solid var(--border, #d1d5db);
    border-radius: 10px;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
  }
  .reset-btn:hover {
    border-color: var(--text-muted);
    color: var(--text-secondary);
  }

  .section-score {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-secondary, #64748b);
    margin-left: auto;
  }
</style>

<script>
  function initExam() {
    document.querySelectorAll('.check-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const section = btn.getAttribute('data-section');
        const sectionEl = document.querySelector(`.exam-section[data-section="${section}"]`);
        if (!sectionEl) return;

        let filled = 0;
        let total = 0;

        sectionEl.querySelectorAll('.exam-q').forEach(q => {
          const type = q.getAttribute('data-type');
          total++;

          if (type === 'choice') {
            if (q.querySelector('input[type="radio"]:checked')) filled++;
          } else if (type === 'select') {
            const sel = q.querySelector('select');
            if (sel && sel.value) filled++;
          } else {
            const input = q.querySelector('input[type="text"], textarea');
            if (input && input.value.trim()) filled++;
          }
        });

        const scoreEl = sectionEl.querySelector('.section-score');
        if (scoreEl) {
          scoreEl.textContent = `${filled}/${total} respondidas`;
          scoreEl.style.color = filled === total ? '#16a34a' : filled > 0 ? '#d97706' : '#94a3b8';
        }

        sectionEl.querySelectorAll('.exam-q').forEach(q => {
          const type = q.getAttribute('data-type');
          if (type === 'choice') {
            q.style.borderColor = q.querySelector('input[type="radio"]:checked') ? '#16a34a' : '#f59e0b';
          } else {
            const input = q.querySelector('input[type="text"], textarea, select');
            q.style.borderColor = (input && input.value.trim()) ? '#16a34a' : '#f59e0b';
          }
        });
      });
    });

    document.querySelectorAll('.reset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const section = btn.getAttribute('data-section');
        const sectionEl = document.querySelector(`.exam-section[data-section="${section}"]`);
        if (!sectionEl) return;

        sectionEl.querySelectorAll('input[type="text"], textarea').forEach(el => { el.value = ''; });
        sectionEl.querySelectorAll('select').forEach(el => { el.selectedIndex = 0; });
        sectionEl.querySelectorAll('input[type="radio"]').forEach(el => { el.checked = false; });
        sectionEl.querySelectorAll('.exam-q').forEach(q => { q.style.borderColor = 'transparent'; });

        const scoreEl = sectionEl.querySelector('.section-score');
        if (scoreEl) scoreEl.textContent = '';
      });
    });
  }

  document.addEventListener('astro:page-load', initExam);
  initExam();
</script>
